# KhodroYar AI backend: copy to ".env" (local) or set as Environment Variables on your host.
# NEVER commit a real ".env". The real key lives only on the server.

# ---- Required -------------------------------------------------------------
# Your GapGPT API key. Leave empty here; set the real value on the server only.
GAPGPT_API_KEY=

# ---- Provider (OpenAI-compatible) ----------------------------------------
# Root, /v1, or a full /v1/chat/completions URL is normalised automatically.
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
# Initial suggestion only. Verify it exists on your account: GET /v1/models
DEFAULT_MODEL=gpt-4o-mini
# Optional comma-separated allow-list of models the app may request. Empty = only DEFAULT_MODEL.
ALLOWED_MODELS=

# ---- Server ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Set to 1 only if you run behind a reverse proxy / PaaS that sets X-Forwarded-For
TRUST_PROXY=0

# ---- Kill switch ----------------------------------------------------------
# Set to 0 to disable the assistant for every app instantly (HTTP 503 to clients).
AI_ENABLED=1

# ---- Access control (optional but recommended) ----------------------------
# Static token the app sends as "Authorization: Bearer <token>". It identifies YOUR app
# only; anything inside an APK can be extracted, so it is NOT a secret. Real protection
# comes from the rate limits and budgets below.
CLIENT_TOKEN=
# Token for GET /admin/usage. Empty = endpoint disabled.
ADMIN_TOKEN=

# ---- Cost / abuse limits --------------------------------------------------
MAX_MESSAGE_CHARS=4000
MAX_MESSAGES=20
MAX_TOTAL_CHARS=24000
MAX_OUTPUT_TOKENS=800
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=200
# Global daily ceilings across all users (0 = unlimited). When reached: HTTP 402 budget_exceeded.
DAILY_REQUEST_BUDGET=2000
DAILY_TOKEN_BUDGET=0

# ---- Network behaviour ----------------------------------------------------
REQUEST_TIMEOUT_MS=30000
# Retries happen only for network errors / timeouts / 502 / 503 / 504, never for 4xx.
MAX_RETRIES=1
