        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="backup"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_backup"
        android:shortcutShortLabel="@string/shortcut_backup_short"
        android:shortcutLongLabel="@string/shortcut_backup_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.khodroyar.app"
            android:targetClass="com.khodroyar.app.MainActivity">
            <extra android:name="khodroyar.target" android:value="backup" />
